<?xml version="1.0" encoding="utf-8"?>
<dev.xacnio.kciktv.shared.ui.widget.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="4dp">

        <!-- Intro blurb lines -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@drawable/bg_shimmer_shape" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shimmer_shape" />

        <View
            android:layout_width="200dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shimmer_shape" />

        <!-- Inventory row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="90dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_shimmer_shape" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="11dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_shimmer_shape" />
            </LinearLayout>

            <View
                android:layout_width="86dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_shimmer_shape" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#262626" />

        <!-- Section header -->
        <View
            android:layout_width="80dp"
            android:layout_height="15dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_shimmer_shape" />

        <View
            android:layout_width="110dp"
            android:layout_height="11dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_shimmer_shape" />

        <!-- Card rows: same 128:169 cells the real grid uses -->
        <include layout="@layout/layout_collectibles_shimmer_row" />

        <include layout="@layout/layout_collectibles_shimmer_row" />

        <!-- Section header -->
        <View
            android:layout_width="80dp"
            android:layout_height="15dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_shimmer_shape" />

        <View
            android:layout_width="110dp"
            android:layout_height="11dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_shimmer_shape" />

        <include layout="@layout/layout_collectibles_shimmer_row" />

    </LinearLayout>

</dev.xacnio.kciktv.shared.ui.widget.ShimmerLayout>
