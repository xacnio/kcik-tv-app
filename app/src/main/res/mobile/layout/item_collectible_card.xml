<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <!-- Card art is natively 128x169, so the cell matches that ratio exactly and fitCenter
         has nothing to letterbox. -->
    <FrameLayout
        android:id="@+id/collectibleCardBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,128:169"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Placeholder while the art loads, exactly the size of the art it stands in for -->
        <dev.xacnio.kciktv.shared.ui.widget.ShimmerLayout
            android:id="@+id/collectibleShimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_shimmer_card" />
        </dev.xacnio.kciktv.shared.ui.widget.ShimmerLayout>

        <ImageView
            android:id="@+id/collectibleCardImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <!-- Shown only on cards the user hasn't unlocked yet -->
        <ImageView
            android:id="@+id/collectibleLockBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_margin="5dp"
            android:padding="3dp"
            android:background="@drawable/bg_lock_badge"
            android:src="@drawable/ic_lock"
            android:contentDescription="@string/collectibles_locked"
            android:tint="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
