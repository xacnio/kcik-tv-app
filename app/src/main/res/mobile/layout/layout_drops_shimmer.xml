<?xml version="1.0" encoding="utf-8"?>
<dev.xacnio.kciktv.shared.ui.widget.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Same padding as dropsRecyclerView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <!-- Intro blurb lines -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_shimmer_shape" />

        <View
            android:layout_width="220dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_shimmer_shape" />

        <include layout="@layout/layout_drops_shimmer_card" />

        <include layout="@layout/layout_drops_shimmer_card" />

        <include layout="@layout/layout_drops_shimmer_card" />

    </LinearLayout>

</dev.xacnio.kciktv.shared.ui.widget.ShimmerLayout>
