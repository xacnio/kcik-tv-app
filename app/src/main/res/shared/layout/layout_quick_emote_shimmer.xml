<?xml version="1.0" encoding="utf-8"?>
<dev.xacnio.kciktv.shared.ui.widget.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Each shimmer cell mirrors item_emote.xml: 40dp container + 2dp margin on each side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#151515"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:gravity="center_vertical">

        <!-- 10 placeholder cells — same footprint as real emote items (44dp each) -->
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />
        <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_shimmer_shape" />

    </LinearLayout>

</dev.xacnio.kciktv.shared.ui.widget.ShimmerLayout>
