<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-emote-bar specific item. emotePlaceholder is a dedicated View (not inside
     ImageView) so it stays visible with zero gaps while Glide/EmoteManager loads. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_margin="2dp"
    android:clipChildren="false"
    android:clickable="true"
    android:focusable="true">

    <!-- Shown while image loads; hidden only after the bitmap/drawable is fully set -->
    <FrameLayout
        android:id="@+id/emotePlaceholder"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_quick_emote_placeholder" />

        <ProgressBar
            android:id="@+id/emoteProgressBar"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#AAAAAA"
            style="?android:attr/progressBarStyleSmall" />

    </FrameLayout>

    <ImageView
        android:id="@+id/emoteImage"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:visibility="invisible" />

</FrameLayout>
